# Copy to `.env` in the repository root. Never commit real secrets.
# Apps load configuration through `@vimla/config`; do not scatter process.env reads.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Web (Next.js). Must be a static NEXT_PUBLIC_* name so Next can inline it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Phase 7 @Vimla UI gate. Off by default; routes exist but stay hidden until this is true.
NEXT_PUBLIC_VIMLA_OPERATOR=false
# Phase 8 Projects UI gate. Off by default; routes stay hidden until this is true.
NEXT_PUBLIC_VIMLA_PROJECTS=false
WEB_PORT=3000

# Admin control plane (separate origin). Never treat a hidden URL as the security boundary.
ADMIN_PORT=3002
ADMIN_ORIGIN=http://localhost:3002
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:3001
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_STEP_UP_SECONDS=900
ADMIN_REQUIRE_TOTP=true
ADMIN_REQUIRE_PASSKEY=false
ADMIN_REPORTING_TIMEZONE=Europe/Moscow
ADMIN_WEBAUTHN_RP_ID=localhost
ADMIN_WEBAUTHN_ORIGIN=http://localhost:3002
ADMIN_LOGIN_IP_LIMIT_PER_MINUTE=10
ADMIN_LOGIN_ACCOUNT_LIMIT_PER_MINUTE=8
ADMIN_LOGIN_GLOBAL_LIMIT_PER_MINUTE=30
ADMIN_ELEVATE_LIMIT_PER_MINUTE=8
ADMIN_QUERY_MAX_RANGE_DAYS=366

# API
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL is the source of truth for payments, subscriptions, usage and provider cost.
DATABASE_URL=postgresql://vimla:vimla@localhost:5432/vimla

# Redis is for queues, cache and coordination only. Never store money or usage here.
REDIS_URL=redis://localhost:6379

# Better Auth. Server-only. Never put this in NEXT_PUBLIC_* or client bundles.
# Replace the local example before staging/production.
BETTER_AUTH_SECRET=local-dev-only-change-me-use-32-chars-min
BETTER_AUTH_URL=http://localhost:3001

# Billing policy. Integer microRUB strings. PostgreSQL TopupPolicyVersion is production truth;
# these remain bootstrap/fallback for local until a published policy exists. Never NEXT_PUBLIC_*.
BILLING_MIN_TOPUP_MICRORUB=100000000
BILLING_MAX_TOPUP_MICRORUB=100000000000
BILLING_TOPUP_RATIO_BPS=3500
BILLING_SUBSCRIPTION_PERIOD_DAYS=30

# Phase 3 AI. Server-only. Never put PROXYAPI_API_KEY in NEXT_PUBLIC_*.
# Leave empty for local/test mock provider. Required in staging/production when AI_TEXT_ENABLED=true.
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
AI_TEXT_ENABLED=true
AI_TEXT_PROVIDER=auto
AI_DEFAULT_MAX_OUTPUT_TOKENS=2048
AI_MAX_MESSAGE_BYTES=16384
AI_MAX_CONTEXT_BYTES=65536
AI_RESERVATION_SAFETY_BPS=2000
AI_MAX_RESERVATION_MICRORUB=10000000
AI_MAX_CONCURRENT_TEXT_REQUESTS_PER_USER=2
AI_TEXT_RATE_LIMIT_PER_MINUTE=20
AI_TEXT_IP_RATE_LIMIT_PER_MINUTE=60
AI_PROVIDER_TIMEOUT_MS=120000

# Phase 7 @Vimla operator. Fail closed unless explicitly enabled.
# Staging/production must set OPERATOR_ENABLED=true to turn the API on; routes alone do not enable it.
# Local/test: set OPERATOR_ENABLED=true and NEXT_PUBLIC_VIMLA_OPERATOR=true together.
OPERATOR_ENABLED=false
OPERATOR_MAX_TOOLS_PER_RUN=8
OPERATOR_CONFIRMATION_TTL_SECONDS=900
OPERATOR_RATE_LIMIT_PER_MINUTE=20

# Phase 8 Projects. Fail closed unless explicitly enabled.
# Staging/production must set PROJECTS_ENABLED=true to turn the API on; routes alone do not enable it.
# Local/test: set PROJECTS_ENABLED=true and NEXT_PUBLIC_VIMLA_PROJECTS=true together.
PROJECTS_ENABLED=false
PROJECTS_MUTATION_LIMIT_PER_MINUTE=60
PROJECTS_INVITE_TTL_DAYS=7

# Phase 3.5 identity. OTP/reset policy is centralized. Never put secrets in NEXT_PUBLIC_*.
AUTH_OTP_DIGITS=6
AUTH_OTP_EXPIRES_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_RESET_TOKEN_EXPIRES_SECONDS=3600
AUTH_DEFAULT_LOCALE=ru
# Signup HTTP validation (not OTP). Duplicate-email retries should not lock a user out.
AUTH_SIGNUP_IP_LIMIT_PER_MINUTE=20
AUTH_LOGIN_WINDOW_SECONDS=10
AUTH_LOGIN_MAX_ATTEMPTS=3
AUTH_OTP_SEND_LIMIT_PER_MINUTE=3
AUTH_OTP_VERIFY_LIMIT_PER_MINUTE=5
AUTH_PASSWORD_RESET_LIMIT_PER_MINUTE=3

# Phase 3.6 notifications. Server-only. Never put these in NEXT_PUBLIC_*.
# local/test default to memory inbox (no real email).
# staging/production MUST use smtp and fail startup otherwise.
EMAIL_PROVIDER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
NOTIFY_EMAIL_RETRY_MAX=2
NOTIFY_EMAIL_PER_DEST_PER_HOUR=8
NOTIFY_EMAIL_PER_IP_PER_HOUR=20
NOTIFY_EMAIL_GLOBAL_PER_MINUTE=40

# Phase 6.5 notification platform. Server-only. Redis is transport, not source of truth.
REMINDER_RECONCILE_INTERVAL_SECONDS=60
REMINDER_RECONCILE_BATCH=100
REMINDER_MAX_LATENESS_MINUTES=1440
NOTIFY_DELIVERY_MAX_ATTEMPTS=6
NOTIFY_DELIVERY_BACKOFF_BASE_MS=5000
NOTIFY_DELIVERY_BACKOFF_CAP_MS=300000
NOTIFY_DELIVERY_LEASE_SECONDS=120
NOTIFY_INBOX_LIMIT_PER_MINUTE=60
# Optional loopback health for Playwright/process managers. Bound to 127.0.0.1 only.
# WORKER_HEALTH_PORT=3102

# Phase 4 payments. Server-only. Never put TBANK_* or PAYMENT_* in NEXT_PUBLIC_*.
# local/test default to PAYMENT_PROVIDER=mock (hosted mock page + signed webhook verification).
# staging/production MUST use tbank and fail startup on mock.
PAYMENT_PROVIDER=mock
PAYMENT_CHECKOUT_LIMIT_PER_MINUTE=10
PAYMENT_WEBHOOK_LIMIT_PER_MINUTE=120
PAYMENT_RECONCILE_AFTER_SECONDS=120
TBANK_ENV=test
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_BASE_URL=
TBANK_NOTIFICATION_BASE_URL=
TBANK_SUCCESS_URL=
TBANK_FAIL_URL=
TBANK_FISCALIZATION_ENABLED=false
TBANK_RECEIPT_TAXATION=
TBANK_RECEIPT_TAX=
TBANK_RECEIPT_PAYMENT_METHOD=
TBANK_RECEIPT_PAYMENT_OBJECT=
TBANK_RECEIPT_FFD_VERSION=
TBANK_RECEIPT_ITEM_NAME=
TBANK_RECURRING_ENABLED=false

# Separate database for destructive integration tests. Never point this at production.
TEST_DATABASE_URL=postgresql://vimla:vimla@localhost:5432/vimla_test

# Future server-only secrets. Never expose these via NEXT_PUBLIC_*.
# PAYMENT_PROVIDER_SECRET=
