# Copy to `.env` in the repository root. Never commit real secrets.
# Apps load configuration through `@vimla/config`; do not scatter process.env reads.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Web (Next.js). Must be a static NEXT_PUBLIC_* name so Next can inline it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_PORT=3000

# API
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL is the source of truth for payments, subscriptions, usage and provider cost.
DATABASE_URL=postgresql://vimla:vimla@localhost:5432/vimla

# Redis is for queues, cache and coordination only. Never store money or usage here.
REDIS_URL=redis://localhost:6379

# Better Auth. Server-only. Never put this in NEXT_PUBLIC_* or client bundles.
# Replace the local example before staging/production.
BETTER_AUTH_SECRET=local-dev-only-change-me-use-32-chars-min
BETTER_AUTH_URL=http://localhost:3001

# Billing policy. Integer microRUB strings. Never put these in NEXT_PUBLIC_*.
BILLING_MIN_TOPUP_MICRORUB=100000000
BILLING_MAX_TOPUP_MICRORUB=100000000000
BILLING_TOPUP_RATIO_BPS=3500
BILLING_SUBSCRIPTION_PERIOD_DAYS=30

# Phase 3 AI. Server-only. Never put PROXYAPI_API_KEY in NEXT_PUBLIC_*.
# Leave empty for local/test mock provider. Required in staging/production when AI_TEXT_ENABLED=true.
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
AI_TEXT_ENABLED=true
AI_TEXT_PROVIDER=auto
AI_DEFAULT_MAX_OUTPUT_TOKENS=2048
AI_MAX_MESSAGE_BYTES=16384
AI_MAX_CONTEXT_BYTES=65536
AI_RESERVATION_SAFETY_BPS=2000
AI_MAX_RESERVATION_MICRORUB=10000000
AI_MAX_CONCURRENT_TEXT_REQUESTS_PER_USER=2
AI_TEXT_RATE_LIMIT_PER_MINUTE=20
AI_TEXT_IP_RATE_LIMIT_PER_MINUTE=60
AI_PROVIDER_TIMEOUT_MS=120000

# Phase 3.5 identity. OTP/reset policy is centralized. Never put secrets in NEXT_PUBLIC_*.
AUTH_OTP_DIGITS=6
AUTH_OTP_EXPIRES_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_RESET_TOKEN_EXPIRES_SECONDS=3600
AUTH_DEFAULT_LOCALE=ru
# Signup HTTP validation (not OTP). Duplicate-email retries should not lock a user out.
AUTH_SIGNUP_IP_LIMIT_PER_MINUTE=20
AUTH_LOGIN_WINDOW_SECONDS=10
AUTH_LOGIN_MAX_ATTEMPTS=3
AUTH_OTP_SEND_LIMIT_PER_MINUTE=3
AUTH_OTP_VERIFY_LIMIT_PER_MINUTE=5
AUTH_PASSWORD_RESET_LIMIT_PER_MINUTE=3

# Phase 3.6 notifications. Server-only. Never put these in NEXT_PUBLIC_*.
# local/test default to memory inbox (no real email/SMS).
# staging/production MUST use smtp + http and fail startup otherwise.
EMAIL_PROVIDER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
SMS_PROVIDER=memory
SMS_HTTP_URL=
SMS_HTTP_AUTHORIZATION=
NOTIFY_EMAIL_RETRY_MAX=2
NOTIFY_SMS_RETRY_MAX=1
NOTIFY_EMAIL_PER_DEST_PER_HOUR=8
NOTIFY_EMAIL_PER_IP_PER_HOUR=20
NOTIFY_EMAIL_GLOBAL_PER_MINUTE=40
NOTIFY_SMS_PER_PHONE_PER_HOUR=4
NOTIFY_SMS_PER_ACCOUNT_PER_HOUR=4
NOTIFY_SMS_PER_IP_PER_HOUR=8
NOTIFY_SMS_GLOBAL_PER_MINUTE=20

# Separate database for destructive integration tests. Never point this at production.
TEST_DATABASE_URL=postgresql://vimla:vimla@localhost:5432/vimla_test

# Future server-only secrets. Never expose these via NEXT_PUBLIC_*.
# PAYMENT_PROVIDER_SECRET=
