{
  "name": "@vimla/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.3",
    "@vimla/config": "workspace:*",
    "@vimla/database": "workspace:*",
    "@vimla/notifications": "workspace:*",
    "@vimla/shared": "workspace:*",
    "better-auth": "^1.7.3",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
