generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1: Better Auth. User.id is the canonical Vimla user identifier.
// Phase 2: billing/usage. PostgreSQL is the source of truth for money.
// Do not store money or usage in Redis.
// Monetary columns must use BIGINT microRUB (1 RUB = 1_000_000 microRUB).

model User {
  id                   String          @id
  name                 String
  email                String
  emailVerified        Boolean         @default(false)
  image                String?
  // Dormant leftover from SMS authentication. Not used for login, OTP, or product UI.
  // Kept to avoid a destructive migration of already-applied identity columns.
  phoneNumber          String?
  phoneNumberVerified  Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  sessions             Session[]
  accounts             Account[]
  preference           UserPreference?
  subscriptions        Subscription[]
  payments             Payment[]
  usageBuckets         UsageBucket[]
  reservations         UsageReservation[]
  ledgerEntries        UsageLedgerEntry[]
  conversations              Conversation[]
  aiRequests                 AiRequest[]
  ownedWorkspaceObjects      WorkspaceObject[] @relation("WorkspacePersonalOwner")
  createdWorkspaceObjects    WorkspaceObject[] @relation("WorkspaceCreatedBy")
  ownedProjects              Project[]         @relation("ProjectOwner")
  projectMemberships         ProjectMember[]
  projectInvitesCreated      ProjectInvite[]   @relation("ProjectInviteCreatedBy")
  userNotifications          UserNotification[]
  notificationDeliveries     NotificationDelivery[]
  operatorRuns               OperatorRun[]
  operatorAuditEvents        OperatorAuditEvent[]
  cryptoDevices              UserCryptoDevice[]
  directMemberships          DirectConversationMember[]
  directMessagesSent         DirectMessage[]            @relation("DirectMessageSender")
  assignedWorkspaceTasks     WorkspaceTask[]            @relation("TaskAssignedBy")
  executionPlans             ExecutionPlan[]
  artifactAccessGrants       ArtifactAccessGrant[]
  twoFactorEnabled           Boolean           @default(false)
  twoFactor            TwoFactor?
  passkeys             Passkey[]
  adminPrincipal       AdminPrincipal?

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model UserPreference {
  userId                 String   @id
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale                 String
  timezone               String?
  reminderInAppEnabled   Boolean  @default(true)
  reminderEmailEnabled   Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("user_preference")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Plan {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  versions  PlanVersion[]

  @@map("plan")
}

// providerBudgetMicroRub is the monthly AI usage grant (not customer revenue).
model PlanVersion {
  id                     String            @id @default(cuid())
  planId                 String
  plan                   Plan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  priceMicroRub          BigInt
  providerBudgetMicroRub BigInt
  providerCostRatioBps   Int
  subscriptionPeriodDays Int               @default(30)
  status                 String            @default("PUBLISHED")
  validFrom              DateTime
  validTo                DateTime?
  publishedAt            DateTime?
  retiredAt              DateTime?
  createdByUserId        String?
  createdAt              DateTime          @default(now())
  subscriptions          Subscription[]
  payments               Payment[]
  entitlements           PlanEntitlement[]

  @@index([planId, validFrom])
  @@index([status, validFrom])
  @@map("plan_version")
}

model PlanEntitlement {
  id            String      @id @default(cuid())
  planVersionId String
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  key           String
  valueKind     String
  unlimited     Boolean     @default(false)
  intValue      BigInt?
  boolValue     Boolean?
  createdAt     DateTime    @default(now())

  @@unique([planVersionId, key])
  @@index([key])
  @@map("plan_entitlement")
}

model Subscription {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  planVersionId String
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status        String
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, status])
  @@index([planVersionId])
  @@map("subscription")
}

model Payment {
  id                       String              @id @default(cuid())
  userId                   String
  user                     User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  billingSubjectType       String              @default("USER")
  provider                 String
  providerPaymentId        String?
  providerOrderId          String
  providerStatus           String?
  paymentUrl               String?
  kind                     String
  amountMicroRub           BigInt
  currency                 String              @default("RUB")
  status                   String
  planVersionId            String?
  planVersion              PlanVersion?        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  topupPolicyVersionId     String?
  topupPolicyVersion       TopupPolicyVersion? @relation(fields: [topupPolicyVersionId], references: [id], onDelete: Restrict)
  paymentMethod            String?
  rawProviderPaymentMethod String?
  idempotencyKey           String
  checkoutSnapshot         Json
  grantedBucketId          String?
  grantedSubscriptionId    String?
  fulfilledAt              DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  events                   PaymentEvent[]
  ledgerEntries            UsageLedgerEntry[]
  economics                PaymentEconomics?

  @@unique([provider, providerPaymentId])
  @@unique([providerOrderId])
  @@unique([userId, kind, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([kind, status, createdAt])
  @@index([planVersionId, createdAt])
  @@map("payment")
}

model PaymentEvent {
  id                String   @id @default(cuid())
  provider          String
  providerEventId   String
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  eventType         String
  providerStatus    String?
  sanitizedPayload  Json?
  processedAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_event")
}

model UsageBucket {
  id               String                         @id @default(cuid())
  userId           String
  user             User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  type             String
  totalMicroRub    BigInt
  spentMicroRub    BigInt                         @default(0)
  reservedMicroRub BigInt                         @default(0)
  expiresAt        DateTime?
  sourceType       String
  sourceId         String
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  allocations      UsageReservationAllocation[]
  ledgerEntries    UsageLedgerEntry[]

  @@index([userId, type, expiresAt])
  @@unique([sourceType, sourceId])
  @@map("usage_bucket")
}

model UsageReservation {
  id                String                        @id @default(cuid())
  userId            String
  user              User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestId         String
  estimatedMicroRub BigInt
  settledMicroRub   BigInt                        @default(0)
  status            String
  createdAt         DateTime                      @default(now())
  settledAt         DateTime?
  allocations       UsageReservationAllocation[]
  ledgerEntries     UsageLedgerEntry[]
  aiRequests        AiRequest[]

  @@unique([userId, requestId])
  @@index([userId, status])
  @@map("usage_reservation")
}

model UsageReservationAllocation {
  id               String            @id @default(cuid())
  reservationId    String
  reservation      UsageReservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  bucketId         String
  bucket           UsageBucket       @relation(fields: [bucketId], references: [id], onDelete: Restrict)
  reservedMicroRub BigInt
  settledMicroRub  BigInt            @default(0)

  @@unique([reservationId, bucketId])
  @@index([bucketId])
  @@map("usage_reservation_allocation")
}

model UsageLedgerEntry {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  bucketId       String?
  bucket         UsageBucket?       @relation(fields: [bucketId], references: [id], onDelete: Restrict)
  reservationId  String?
  reservation    UsageReservation?  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  paymentId      String?
  payment        Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  type           String
  amountMicroRub BigInt
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([bucketId])
  @@index([reservationId])
  @@map("usage_ledger_entry")
}

// Phase 3: curated AI catalog, conversations and metered text requests.
// Prices are versioned. Browser never supplies providerModelId or price.

model AiModel {
  id                  String                 @id @default(cuid())
  slug                String                 @unique
  displayName         String
  vendor              String
  provider            String
  providerModelId     String
  active              Boolean                @default(true)
  visible             Boolean                @default(true)
  supportsStreaming   Boolean                @default(true)
  contextWindowTokens Int
  maxOutputTokens     Int
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  priceVersions       AiModelPriceVersion[]
  aiRequests          AiRequest[]

  @@map("ai_model")
}

model AiModelPriceVersion {
  id                            String      @id @default(cuid())
  modelId                       String
  model                         AiModel     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  inputMicroRubPerMillion       BigInt
  outputMicroRubPerMillion      BigInt
  cacheReadMicroRubPerMillion   BigInt?
  cacheWriteMicroRubPerMillion  BigInt?
  effectiveFrom                 DateTime
  effectiveTo                   DateTime?
  verifiedAt                    DateTime
  source                        String
  createdAt                     DateTime    @default(now())
  aiRequests                    AiRequest[]

  @@index([modelId, effectiveFrom])
  @@map("ai_model_price_version")
}

model Conversation {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  title      String?
  kind       String      @default("CHAT")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  messages                 Message[]
  aiRequests               AiRequest[]
  sourcedWorkspaceObjects  WorkspaceObject[]
  operatorRuns             OperatorRun[]
  executionPlans           ExecutionPlan[]

  @@index([userId, updatedAt])
  @@index([userId, kind])
  @@map("conversation")
  // Partial unique index conversation_one_operator_per_user (userId WHERE kind = 'OPERATOR') is in SQL.
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  role           String
  content        String
  status         String
  aiRequestId    String?
  aiRequest      AiRequest?   @relation(fields: [aiRequestId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sourcedWorkspaceObjects WorkspaceObject[]
  operatorRunId           String?
  operatorRun             OperatorRun?      @relation(fields: [operatorRunId], references: [id], onDelete: SetNull)
  executionPlan           ExecutionPlan?

  @@index([conversationId, createdAt])
  @@index([aiRequestId])
  @@index([operatorRunId])
  @@map("message")
}

model AiRequest {
  id                         String              @id @default(cuid())
  userId                     String
  user                       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversationId             String
  conversation               Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  modelId                    String
  model                      AiModel             @relation(fields: [modelId], references: [id], onDelete: Restrict)
  priceVersionId             String
  priceVersion               AiModelPriceVersion @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  reservationId              String?
  reservation                UsageReservation?   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  clientRequestId            String
  provider                   String
  providerModelId            String
  providerRequestId          String?
  status                     String
  financialStatus            String
  estimatedInputTokens       Int
  maxOutputTokens            Int
  estimatedCostMicroRub      BigInt
  actualInputTokens          Int?
  actualOutputTokens         Int?
  reasoningTokens            Int?
  cacheReadTokens            Int?
  cacheWriteTokens           Int?
  providerActualCostMicroRub BigInt?
  userSettledUsageMicroRub   BigInt?
  outputText                 String?
  createdAt                  DateTime            @default(now())
  startedAt                  DateTime?
  finishedAt                 DateTime?
  messages                   Message[]
  aiExecution                AIExecution?
  providerTurn               AIProviderTurn?

  @@unique([userId, clientRequestId])
  @@index([conversationId, createdAt])
  @@index([reservationId])
  @@index([status])
  @@index([createdAt])
  @@map("ai_request")
}

// Phase 4.5: versioned commercial policy and internal finance facts.
// TOPUP buckets never expire (expiresAt IS NULL). No public finance API.

model TopupPolicyVersion {
  id                  String    @id @default(cuid())
  status              String
  minPurchaseMicroRub BigInt
  maxPurchaseMicroRub BigInt
  usageGrantRatioBps  Int
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  publishedAt         DateTime?
  retiredAt           DateTime?
  createdByUserId     String?
  sourceKind          String    @default("BOOTSTRAP")
  createdAt           DateTime  @default(now())
  payments            Payment[]

  @@index([status, effectiveFrom])
  @@map("topup_policy_version")
}

model PaymentFeePolicyVersion {
  id                 String              @id @default(cuid())
  provider           String
  paymentMethod      String
  feeBps             Int
  feeVatBps          Int                 @default(0)
  minimumFeeMicroRub BigInt?
  fixedFeeMicroRub   BigInt?
  status             String
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  sourceDescription  String
  sourceQuality      String
  verifiedAt         DateTime?
  publishedAt        DateTime?
  retiredAt          DateTime?
  createdByUserId    String?
  createdAt          DateTime            @default(now())
  economics          PaymentEconomics[]

  @@index([provider, paymentMethod, status, effectiveFrom], map: "payment_fee_policy_lookup_idx")
  @@map("payment_fee_policy_version")
}

model FiscalizationFeePolicyVersion {
  id               String              @id @default(cuid())
  provider         String
  mode             String
  percentageBps    Int?
  fixedFeeMicroRub BigInt?
  status           String
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  sourceDescription String
  sourceQuality    String
  verifiedAt       DateTime?
  publishedAt      DateTime?
  retiredAt        DateTime?
  createdByUserId  String?
  createdAt        DateTime            @default(now())
  economics        PaymentEconomics[]

  @@index([provider, mode, status, effectiveFrom], map: "fiscalization_fee_policy_lookup_idx")
  @@map("fiscalization_fee_policy_version")
}

model TaxReservePolicyVersion {
  id              String    @id @default(cuid())
  reserveBps      Int
  enabled         Boolean   @default(false)
  status          String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  sourceQuality   String
  publishedAt     DateTime?
  retiredAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([status, effectiveFrom])
  @@map("tax_reserve_policy_version")
}

model BusinessGuardrailVersion {
  id                                        String    @id @default(cuid())
  targetMinimumMarginBps                    Int
  projectCreationWindowDays                 Int?
  projectCreationLimitFree                  Int?
  projectCreationLimit199                   Int?
  projectCreationLimit499                   Int?
  projectCreationLimit999                   Int?
  freeActiveProjectReallocationCooldownDays Int?
  projectTrashRetentionDays                 Int?
  sourceQuality                             String    @default("UNVERIFIED")
  status                                    String
  effectiveFrom                             DateTime
  effectiveTo                               DateTime?
  publishedAt                               DateTime?
  retiredAt                                 DateTime?
  createdByUserId                           String?
  createdAt                                 DateTime  @default(now())

  @@index([status, effectiveFrom])
  @@map("business_guardrail_version")
}

model PaymentEconomics {
  id                               String                          @id @default(cuid())
  paymentId                        String                          @unique
  payment                          Payment                         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  grossAmountMicroRub              BigInt
  paymentMethod                    String?
  paymentFeePolicyVersionId        String?
  paymentFeePolicyVersion          PaymentFeePolicyVersion?        @relation(fields: [paymentFeePolicyVersionId], references: [id], onDelete: Restrict)
  estimatedAcquiringFeeMicroRub    BigInt?
  estimatedAcquiringFeeVatMicroRub BigInt?
  fiscalizationFeePolicyVersionId  String?
  fiscalizationFeePolicyVersion    FiscalizationFeePolicyVersion?  @relation(fields: [fiscalizationFeePolicyVersionId], references: [id], onDelete: Restrict)
  estimatedFiscalizationFeeMicroRub BigInt?
  actualAcquiringFeeMicroRub       BigInt?
  actualAcquiringFeeVatMicroRub    BigInt?
  actualFiscalizationFeeMicroRub   BigInt?
  refundedAmountMicroRub           BigInt                          @default(0)
  chargebackAmountMicroRub         BigInt                          @default(0)
  economicsStatus                  String
  financialReconciledAt            DateTime?
  createdAt                        DateTime                        @default(now())
  updatedAt                        DateTime                        @updatedAt

  @@index([economicsStatus])
  @@map("payment_economics")
}

model VariableCostEntry {
  id             String   @id @default(cuid())
  kind           String
  amountMicroRub BigInt
  occurredAt     DateTime
  sourceType     String
  sourceId       String
  quality        String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([kind, occurredAt])
  @@index([sourceType, sourceId])
  @@map("variable_cost_entry")
}

// Better Auth two-factor plugin. TOTP secret and backup codes are never returned by Admin APIs.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@map("two_factor")
}

// Better Auth passkey plugin. Passkey private keys are never stored by Vimla.
model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model AdminPrincipal {
  id              String               @id @default(cuid())
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          String
  createdAt       DateTime             @default(now())
  disabledAt      DateTime?
  createdByUserId String?
  roles           AdminPrincipalRole[]
  sessions        AdminSession[]
  auditLogs       AdminAuditLog[]

  @@index([status])
  @@map("admin_principal")
}

model AdminRole {
  id          String               @id @default(cuid())
  code        String               @unique
  permissions String[]
  principals  AdminPrincipalRole[]

  @@map("admin_role")
}

model AdminPrincipalRole {
  principalId String
  principal   AdminPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict)
  roleId      String
  role        AdminRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([principalId, roleId])
  @@map("admin_principal_role")
}

model AdminSession {
  id               String         @id @default(cuid())
  principalId      String
  principal        AdminPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict)
  tokenHash        String         @unique
  createdAt        DateTime       @default(now())
  expiresAt        DateTime
  idleExpiresAt    DateTime
  lastStrongAuthAt DateTime
  lastSeenAt       DateTime       @default(now())
  revokedAt        DateTime?
  userAgentSummary String?
  ipHash           String?

  @@index([principalId, revokedAt])
  @@index([expiresAt])
  @@map("admin_session")
}

model AdminAuditLog {
  id               String          @id @default(cuid())
  adminUserId      String
  principalId      String?
  principal        AdminPrincipal? @relation(fields: [principalId], references: [id], onDelete: Restrict)
  adminSessionId   String?
  action           String
  resourceType     String
  resourceId       String?
  requestId        String?
  ipHash           String?
  userAgentSummary String?
  beforeSnapshot   Json?
  afterSnapshot    Json?
  reason           String?
  createdAt        DateTime        @default(now())

  @@index([createdAt])
  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_log")
}

model OperatorSetting {
  key             String   @id
  valueJson       Json
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  @@map("operator_setting")
}

model AdminSecurityEvent {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  ipHash    String?
  createdAt DateTime @default(now())
  metadata  Json?

  @@index([kind, createdAt])
  @@map("admin_security_event")
}

// Phase 8: Projects + collaboration. Entitlement lock state is computed from owner/member
// plans and ProjectMember.lastOpenedAt; it is never stored as a durable project status.
model Project {
  id          String          @id @default(uuid())
  ownerUserId String
  owner       User            @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  invites     ProjectInvite[]

  @@index([ownerUserId, createdAt])
  @@map("project")
}

model ProjectMember {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         String
  lastOpenedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId, lastOpenedAt])
  @@index([projectId, role])
  @@map("project_member")
}

model ProjectInvite {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email           String
  role            String
  tokenHash       String    @unique
  createdByUserId String
  createdBy       User      @relation("ProjectInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([projectId, email])
  @@index([email, expiresAt])
  @@map("project_invite")
}

// Phase 6: personal Workspace objects. PROJECT scope remains a later migration; do not add a dangling projectId.
model WorkspaceObject {
  id                     String     @id @default(uuid())
  kind                   String
  scopeType              String     @default("PERSONAL")
  personalOwnerUserId    String
  personalOwner          User       @relation("WorkspacePersonalOwner", fields: [personalOwnerUserId], references: [id], onDelete: Restrict)
  createdByUserId        String
  createdBy              User       @relation("WorkspaceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sourceConversationId   String?
  sourceConversation     Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessageId        String?
  sourceMessage          Message?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  archivedAt             DateTime?
  deletedAt              DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  task                   WorkspaceTask?
  reminder               WorkspaceReminder?
  list                   WorkspaceList?
  note                   WorkspaceNote?
  linkedReminders        WorkspaceReminder[] @relation("ReminderLinkedTask")

  @@index([personalOwnerUserId, kind, deletedAt])
  @@index([personalOwnerUserId, archivedAt, updatedAt])
  @@index([kind, deletedAt, updatedAt])
  @@map("workspace_object")
}

model WorkspaceTask {
  objectId     String          @id
  object       WorkspaceObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       String
  priority     String?
  dueAt        DateTime?
  completedAt  DateTime?
  assignedByUserId         String?
  assignedBy               User?    @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignmentSourceType     String?
  assignmentSourceId       String?

  @@index([status, dueAt])
  @@index([assignedByUserId])
  @@map("workspace_task")
}

model WorkspaceReminder {
  objectId            String           @id
  object              WorkspaceObject  @relation(fields: [objectId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  scheduledAt         DateTime
  timezone            String
  status              String
  linkedTaskObjectId  String?
  linkedTask          WorkspaceObject? @relation("ReminderLinkedTask", fields: [linkedTaskObjectId], references: [id], onDelete: SetNull)
  canceledAt          DateTime?
  deliveredAt         DateTime?

  @@index([status, scheduledAt])
  @@index([linkedTaskObjectId])
  @@map("workspace_reminder")
}

model WorkspaceList {
  objectId    String           @id
  object      WorkspaceObject  @relation(fields: [objectId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  items       WorkspaceListItem[]

  @@index([type])
  @@map("workspace_list")
}

model WorkspaceListItem {
  id           String        @id @default(uuid())
  listObjectId String
  list         WorkspaceList @relation(fields: [listObjectId], references: [objectId], onDelete: Cascade)
  text         String
  position     Int
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([listObjectId, position])
  @@map("workspace_list_item")
}

model WorkspaceNote {
  objectId         String          @id
  object           WorkspaceObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  title            String
  contentMarkdown  String
  pinnedAt         DateTime?

  @@index([pinnedAt])
  @@map("workspace_note")
}

// Phase 6.5: persisted in-app inbox. PostgreSQL is source of truth; Redis/BullMQ is transport only.
model UserNotification {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  sourceType     String
  sourceId       String?
  occurrenceKey  String
  title          String
  body           String?
  hrefPath       String?
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  deliveries     NotificationDelivery[]

  @@unique([userId, type, occurrenceKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("user_notification")
}

// Phase 6.5: durable delivery intent. Unique per source occurrence + channel.
model NotificationDelivery {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationType     String
  sourceType           String
  sourceId             String
  occurrenceKey        String
  channel              String
  status               String
  scheduledFor         DateTime
  nextAttemptAt        DateTime?
  attemptCount         Int       @default(0)
  processingToken      String?
  processingUntil      DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  skippedAt            DateTime?
  providerMessageId    String?
  errorCode            String?
  errorClass           String?
  userNotificationId   String?
  userNotification     UserNotification? @relation(fields: [userNotificationId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([sourceType, sourceId, occurrenceKey, channel])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@map("notification_delivery")
}

// Phase 7: @Vimla operator runtime. Planner LLM never receives userId/permissions.
// Tool side effects go through workspace/notification services with ActorContext.
model OperatorRun {
  id                       String   @id @default(uuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversationId           String
  conversation             Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  userMessageId            String?
  assistantMessageId       String?
  clientRequestId          String
  continueClientRequestId  String?
  plannerClientRequestId   String?
  plannerAiRequestId       String?
  status                   String
  userText                 String
  locale                   String
  publicMessage            String?
  clarificationQuestion    String?
  confirmationTokenHash    String?
  confirmationExpiresAt    DateTime?
  plannerOutput            String?
  errorCode                String?
  invocationScope          String   @default("PERSONAL")
  directConversationId     String?
  directConversation       DirectConversation? @relation(fields: [directConversationId], references: [id], onDelete: Restrict)
  contextOwnIncluded       Boolean  @default(false)
  contextPeerIncluded      Boolean  @default(false)
  contextPeerDenied        Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  steps                    OperatorRunStep[]
  auditEvents              OperatorAuditEvent[]
  messages                 Message[]

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([directConversationId, createdAt])
  @@index([status, updatedAt])
  @@map("operator_run")
}

model OperatorRunStep {
  id             String      @id @default(uuid())
  runId          String
  run            OperatorRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  sequence       Int
  toolName       String
  status         String
  inputJson      Json
  publicKind     String
  publicTitle    String
  publicDetail   String?
  publicHrefPath String?
  objectId       String?
  errorCode      String?
  idempotencyKey String
  executedAt     DateTime?
  createdAt      DateTime    @default(now())
  toolExecution  ToolExecution?

  @@unique([runId, sequence])
  @@unique([runId, idempotencyKey])
  @@index([runId, status])
  @@map("operator_run_step")
}

model OperatorAuditEvent {
  id         String      @id @default(uuid())
  runId      String
  run        OperatorRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  toolName   String
  operation  String
  objectKind String?
  objectId   String?
  result     String
  createdAt  DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([runId, createdAt])
  @@map("operator_audit_event")
}

// Phase 9: E2EE Direct Chats. Server stores ciphertext + public device material only.
model UserCryptoDevice {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  identityEd25519Public   String
  identityX25519Public    String
  signedPrekeyId          Int
  signedPrekeyPublic      String
  signedPrekeySignature   String
  label                   String?
  revokedAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  oneTimePrekeys          DirectOneTimePrekey[]
  sentMessages            DirectMessage[]
  receivedEnvelopes       DirectMessageEnvelope[]

  @@index([userId, revokedAt])
  @@map("user_crypto_device")
}

model DirectOneTimePrekey {
  id          String           @id @default(uuid())
  deviceId    String
  device      UserCryptoDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  keyId       Int
  publicKey   String
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@unique([deviceId, keyId])
  @@index([deviceId, consumedAt])
  @@map("direct_one_time_prekey")
}

model DirectConversation {
  id            String   @id @default(uuid())
  pairKey       String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())
  members       DirectConversationMember[]
  messages      DirectMessage[]
  operatorRuns  OperatorRun[]

  @@index([lastMessageAt])
  @@map("direct_conversation")
}

model DirectConversationMember {
  id                              String             @id @default(uuid())
  conversationId                  String
  conversation                    DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  userId                          String
  user                            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadAt                      DateTime?
  lastReadMessageCreatedAt        DateTime?
  shareOwnHistoryWithVimla        Boolean            @default(false)
  includePeerHistoryWhenInvoking  Boolean            @default(false)
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
  @@map("direct_conversation_member")
}

model DirectMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderUserId   String
  sender         User               @relation("DirectMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  senderDeviceId String
  senderDevice   UserCryptoDevice   @relation(fields: [senderDeviceId], references: [id], onDelete: Restrict)
  clientMessageId String
  kind           String
  createdAt      DateTime           @default(now())
  envelopes      DirectMessageEnvelope[]

  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderDeviceId, createdAt])
  @@map("direct_message")
}

model DirectMessageEnvelope {
  id                   String           @id @default(uuid())
  messageId            String
  message              DirectMessage    @relation(fields: [messageId], references: [id], onDelete: Restrict)
  recipientDeviceId    String
  recipientDevice      UserCryptoDevice @relation(fields: [recipientDeviceId], references: [id], onDelete: Restrict)
  senderDeviceId       String
  headerB64            String
  ciphertextB64        String
  dhPublicB64          String
  messageNumber        Int
  previousChainLength  Int
  senderSignatureB64   String
  x3dhInitJson         String?
  createdAt            DateTime         @default(now())

  @@unique([messageId, recipientDeviceId])
  @@unique([senderDeviceId, recipientDeviceId, dhPublicB64, messageNumber])
  @@index([recipientDeviceId, createdAt])
  @@map("direct_message_envelope")
}

// Context-aware orchestration persistence. Additive: existing Operator/AiRequest/workspace
// tables remain authoritative for their current domains and financial history.
model ExecutionPlan {
  id             String       @id @default(uuid())
  messageId      String       @unique
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Restrict)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  schemaVersion  Int
  version        Int          @default(1)
  planHash       String
  goal           String
  status         String       @default("PLANNED")
  maxParallelism Int
  startedAt      DateTime?
  frozenAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  invocations    Invocation[]
  dependencies   InvocationDependency[]
  contextSnapshot ContextSnapshot?

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@map("execution_plan")
}

model Invocation {
  id                 String        @id @default(uuid())
  planId             String
  plan               ExecutionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  sequence           Int
  purpose            String
  targetKind         String
  targetModelSlug    String?
  targetAgentId      String?
  outputDeclarations Json
  acceptanceCriteria Json
  riskClass          String
  approvalPolicy     String
  failurePolicy      String
  joinPolicy         String
  status             String        @default("PENDING")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  outgoingDependencies InvocationDependency[] @relation("InvocationDependencyFrom")
  incomingDependencies InvocationDependency[] @relation("InvocationDependencyTo")
  runs               InvocationRun[]
  artifacts          Artifact[]
  contextBundle      ContextBundle?

  @@unique([planId, sequence])
  @@index([planId, status])
  @@index([status, createdAt])
  @@map("invocation")
}

model InvocationDependency {
  id               String        @id @default(uuid())
  planId           String
  plan             ExecutionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  fromInvocationId String
  fromInvocation   Invocation    @relation("InvocationDependencyFrom", fields: [fromInvocationId], references: [id], onDelete: Restrict)
  toInvocationId   String
  toInvocation     Invocation    @relation("InvocationDependencyTo", fields: [toInvocationId], references: [id], onDelete: Restrict)
  conditionKind    String
  conditionOutcome String        @default("")
  inputBindings    Json
  createdAt        DateTime      @default(now())

  @@unique([fromInvocationId, toInvocationId, conditionKind, conditionOutcome])
  @@index([planId])
  @@index([toInvocationId, conditionKind])
  @@map("invocation_dependency")
}

model InvocationRun {
  id             String     @id @default(uuid())
  invocationId   String
  invocation     Invocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  attempt        Int
  idempotencyKey String     @unique
  status         String
  outcome        String?
  errorCode      String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  aiExecution    AIExecution?
  toolExecution  ToolExecution?
  evaluation     Evaluation?

  @@unique([invocationId, attempt])
  @@index([invocationId, status])
  @@index([status, createdAt])
  @@map("invocation_run")
}

model ContextSnapshot {
  id           String        @id @default(uuid())
  planId       String        @unique
  plan         ExecutionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  version      Int           @default(1)
  fingerprint  String
  createdAt    DateTime      @default(now())
  items        ContextSnapshotItem[]
  bundles      ContextBundle[]

  @@index([createdAt])
  @@map("context_snapshot")
}

model ContextSnapshotItem {
  id            String          @id @default(uuid())
  snapshotId    String
  snapshot      ContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sequence      Int
  sourceType    String
  sourceId      String
  sourceVersion String?
  fingerprint   String
  classification String
  contentRef    String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  @@unique([snapshotId, sequence])
  @@index([sourceType, sourceId])
  @@map("context_snapshot_item")
}

model ContextBundle {
  id           String          @id @default(uuid())
  invocationId String          @unique
  invocation   Invocation      @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  snapshotId   String
  snapshot     ContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  fingerprint  String
  manifest     Json
  createdAt    DateTime        @default(now())

  @@index([snapshotId])
  @@map("context_bundle")
}

model Artifact {
  id                  String     @id @default(uuid())
  creatorInvocationId String
  creatorInvocation   Invocation @relation(fields: [creatorInvocationId], references: [id], onDelete: Restrict)
  outputName          String
  type                String
  classification      String
  metadata            Json?
  createdAt           DateTime   @default(now())
  versions            ArtifactVersion[]
  accessGrants        ArtifactAccessGrant[]

  @@unique([creatorInvocationId, outputName])
  @@index([creatorInvocationId, createdAt])
  @@index([type, createdAt])
  @@map("artifact")
}

model ArtifactVersion {
  id          String   @id @default(uuid())
  artifactId  String
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  version     Int
  contentRef  String?
  contentJson Json?
  fingerprint String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@unique([artifactId, version])
  @@index([fingerprint])
  @@map("artifact_version")
}

model ArtifactAccessGrant {
  id            String   @id @default(uuid())
  artifactId    String
  artifact      Artifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  granteeUserId String
  granteeUser   User     @relation(fields: [granteeUserId], references: [id], onDelete: Restrict)
  permission    String
  createdAt     DateTime @default(now())
  revokedAt     DateTime?

  @@unique([artifactId, granteeUserId, permission])
  @@index([granteeUserId, revokedAt])
  @@map("artifact_access_grant")
}

model Evaluation {
  id              String        @id @default(uuid())
  invocationRunId String        @unique
  invocationRun   InvocationRun @relation(fields: [invocationRunId], references: [id], onDelete: Restrict)
  evaluatorKind   String
  outcome         String
  confidence      Float
  inputFingerprint String?
  criteriaResults Json
  summary         String?
  createdAt       DateTime      @default(now())

  @@index([outcome, createdAt])
  @@map("evaluation")
}

model AIExecution {
  id              String           @id @default(uuid())
  invocationRunId String           @unique
  invocationRun   InvocationRun    @relation(fields: [invocationRunId], references: [id], onDelete: Restrict)
  aiRequestId     String           @unique
  aiRequest       AiRequest        @relation(fields: [aiRequestId], references: [id], onDelete: Restrict)
  providerTurns   AIProviderTurn[]
  createdAt       DateTime         @default(now())

  @@map("ai_execution")
}

model AIProviderTurn {
  id             String      @id @default(uuid())
  aiExecutionId  String
  aiExecution    AIExecution @relation(fields: [aiExecutionId], references: [id], onDelete: Restrict)
  turnIndex      Int
  aiRequestId    String      @unique
  aiRequest      AiRequest   @relation(fields: [aiRequestId], references: [id], onDelete: Restrict)
  idempotencyKey String      @unique
  status          String
  toolCallsJson   Json?
  toolResultsJson      Json?
  toolCallError        Boolean     @default(false)
  providerInterrupted  Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([aiExecutionId, turnIndex])
  @@index([aiExecutionId, status])
  @@index([status, updatedAt])
  @@map("ai_provider_turn")
}

model ToolExecution {
  id                String           @id @default(uuid())
  invocationRunId   String           @unique
  invocationRun     InvocationRun    @relation(fields: [invocationRunId], references: [id], onDelete: Restrict)
  operatorRunStepId String?          @unique
  operatorRunStep   OperatorRunStep? @relation(fields: [operatorRunStepId], references: [id], onDelete: Restrict)
  toolName          String
  idempotencyKey    String           @unique
  status            String
  objectType        String?
  objectId          String?
  resultJson        Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([toolName, status])
  @@map("tool_execution")
}
